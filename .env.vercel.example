# Vercel Production Environment Variables
# Add these in Vercel Dashboard > Project Settings > Environment Variables

# Required for database connection
# DATABASE_URL: Pooled connection (recommended for queries)
# Use the connection string ending with -pooler for Vercel
DATABASE_URL="postgresql://[user]:[password]@[endpoint]/[dbname]?sslmode=require&channel_binding=require"
# DIRECT_URL: Unpooled connection for migrations
DIRECT_URL="postgresql://[user]:[password]@[endpoint]/[dbname]?sslmode=require&channel_binding=require"

# Better Auth (update URL for your domain)
BETTER_AUTH_SECRET="your-production-secret-min-32-chars"
BETTER_AUTH_URL="https://your-domain.com"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Midtrans (production)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="true"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""

# Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# Resend
RESEND_API_KEY=""

# App URL
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Vercel Cron Secret
CRON_SECRET=""

# Admin Secret
ADMIN_SECRET=""